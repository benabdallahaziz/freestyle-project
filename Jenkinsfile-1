pipeline {
    agent any
    options {
        buildDiscarder(logRotator(numToKeepStr: '5'))
    }
    environment {
        MAVEN_OPTS = "-Dmaven.repo.local=${env.JENKINS_HOME}/.m2/repository"
        // Use environment-specific database URL
        MYSQL_HOST = 'mysql-container'  // Will be the Docker container name
    }
    stages {
        stage('Start MySQL') {
            steps {
                script {
                    sh '''
                        docker run --name mysql-container \
                            -e MYSQL_ALLOW_EMPTY_PASSWORD=yes \
                            -e MYSQL_DATABASE=studentdb \
                            -p 3306:3306 \
                            -d mysql:8
                        # Wait for MySQL to be ready
                        sleep 30
                    '''
                }
            }
        }
        stage('Scan') {
            steps {
                withSonarQubeEnv('sq1') {
                    sh 'chmod +x mvnw'
                    sh './mvnw clean verify org.sonarsource.scanner.maven:sonar-maven-plugin:3.9.0.2155:sonar'
                }
            }
        }
        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }
    }
    post {
        always {
            // Clean up MySQL container
            sh 'docker stop mysql-container || true'
            sh 'docker rm mysql-container || true'
            archiveArtifacts artifacts: '**/target/*.jar', allowEmptyArchive: true
            junit '**/target/surefire-reports/*.xml'
        }
    }
}